package canvas

// VaultRestoreAppForm renders the visible "Restore Vault" view body: a start
// button, the restore URL readout (deep-linked to the human-only one-time page
// where the recovery seed is entered), and a live status line that polls the
// app-only vault_restore_status helper until done. The document <head> (the
// composition root's injected theme stylesheet) and the ESM module <script>
// (bundle "vault-restore" — appsassets/dist/vault-restore.js — resolved
// through the Renderer's asset source) are supplied by Renderer.RenderDoc, so
// this templ authors only the app-specific markup.
//
// Ported unchanged from pinner-cli internal/mcpapp vault_restore_app.templ:
// the element ids and classes below are the hooks the "vault-restore" JS
// bundle queries; do not rename them without rebuilding the bundle.
templ VaultRestoreAppForm() {
	<div class="app-shell">
		<h1 class="app-title">Restore Vault</h1>
		<button id="vault-restore-start" type="button" class="btn-primary">Start vault restore</button>
		<div class="card">
			Restore: <a id="vault-restore-url" href="#" target="_blank" rel="noopener" class="muted underline underline-offset-2">pending</a>
		</div>
		<div id="vault-restore-status" class="status"></div>
	</div>
}
