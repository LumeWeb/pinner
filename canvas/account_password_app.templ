package canvas

// AccountPasswordAppForm renders the visible "Change Password" view body: a
// start button, a deep-link readout for the one-time password change page, and
// a status line. The document <head> (the composition root's injected theme
// stylesheet) and the ESM module <script> (bundle "account-password" —
// appsassets/dist/account-password.js — resolved through the Renderer's asset
// source) are supplied by Renderer.RenderDoc, so this templ authors only the
// app-specific markup.
//
// Ported unchanged from pinner-cli internal/mcpapp account_password_app.templ:
// the element ids and classes below are the hooks the "account-password" JS
// bundle queries; do not rename them without rebuilding the bundle.
templ AccountPasswordAppForm() {
	<div class="app-shell">
		<h1 class="app-title">Change Password</h1>
		<p class="muted">Mint a one-time page to change your Pinner password. The change runs in your browser; your password never reaches this chat.</p>
		<button type="button" id="pw-start" class="btn-primary">Start password change</button>
		<div class="card">
			<a id="pw-url" href="#" class="link-ready" style="display:none"></a>
		</div>
		<div id="pw-status" class="status"></div>
	</div>
}
