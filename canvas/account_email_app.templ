package canvas

// AccountEmailAppForm renders the visible "Change Email" view body: a start
// button, a deep-link readout for the one-time email change page, and a status
// line. The document <head> (the composition root's injected theme stylesheet)
// and the ESM module <script> (bundle "account-email" —
// appsassets/dist/account-email.js — resolved through the Renderer's asset
// source) are supplied by Renderer.RenderDoc, so this templ authors only the
// app-specific markup.
//
// Ported unchanged from pinner-cli internal/mcpapp account_email_app.templ:
// the element ids and classes below are the hooks the "account-email" JS
// bundle queries; do not rename them without rebuilding the bundle.
templ AccountEmailAppForm() {
	<div class="app-shell">
		<h1 class="app-title">Change Email</h1>
		<p class="muted">Mint a one-time page to change your Pinner email. The change runs in your browser; your password never reaches this chat.</p>
		<button type="button" id="em-start" class="btn-primary">Start email change</button>
		<div class="card">
			<a id="em-url" href="#" class="link-ready" style="display:none"></a>
		</div>
		<div id="em-status" class="status"></div>
	</div>
}
