package canvas

// VaultUploadAppForm renders the visible "Upload to Vault" view body: the file
// picker / vault destination path form, the live status line, and the result
// readout. The document <head> (the composition root's injected theme
// stylesheet) and the ESM module <script> (bundle "vault-upload" —
// appsassets/dist/vault-upload.js — resolved through the Renderer's asset
// source) are supplied by Renderer.RenderDoc, so this templ authors only the
// app-specific markup.
//
// Ported unchanged from pinner-cli internal/mcpapp vault_upload_app.templ: the
// element ids and classes below are the hooks the "vault-upload" JS bundle
// queries; do not rename them without rebuilding the bundle.
templ VaultUploadAppForm() {
	<div class="app-shell">
		<h1 class="app-title">Upload to Vault</h1>
		<form id="vault-upload-form" class="mt-2">
			<label for="vfile" class="form-label">File</label>
			<div class="file-field">
				<input id="vfile" name="vfile" type="file" class="file-input"/>
				<div class="file-picker">
					<span class="file-btn">Choose file</span>
					<span id="vfile-name" class="file-name">No file chosen</span>
				</div>
			</div>
			<label for="vault-path" class="form-label">Vault path</label>
			<input id="vault-path" name="vault-path" class="form-input" placeholder="vault:/uploads/document.pdf" autocomplete="off" spellcheck="false"/>
			<button type="submit" class="btn-primary" id="vstart">Upload</button>
		</form>
		<div id="vault-upload-status" class="status"></div>
		<div class="card">
			Stored at: <code id="out-path" class="mono text-accent">—</code>
		</div>
	</div>
}
